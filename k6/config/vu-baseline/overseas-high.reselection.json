{
  "schemaVersion": 1,
  "workloadAxis": "target-vus",
  "fixtureTemplate": "config/fixture-template.json",
  "randomSeed": 20261011,
  "requestTimeout": "10s",
  "auth": {
    "mode": "automatic",
    "tokenPoolSize": null,
    "accountWorkers": 4,
    "tokenValidityMarginSeconds": 60
  },
  "measurement": {
    "executor": "per-vu-iterations",
    "vus": null,
    "iterations": 1,
    "maxDuration": "10m",
    "gracefulStop": "90s"
  },
  "warmup": {
    "enabled": true,
    "tokenPoolSize": 60,
    "execution": {
      "executor": "ramping-arrival-rate",
      "timeUnit": "1s",
      "startRate": 1,
      "stages": [
        {
          "duration": "60s",
          "target": 1
        }
      ],
      "preAllocatedVUs": 80,
      "maxVUs": 80,
      "gracefulStop": "90s"
    }
  },
  "prometheus": {
    "job": "imticket-v2",
    "application": "imticket-v2",
    "scrapeIntervalSeconds": 5,
    "stepSeconds": 5,
    "rateWindow": "30s",
    "contextBeforeSeconds": 30,
    "contextAfterSeconds": 5,
    "settleTimeoutSeconds": 15,
    "queryTimeoutSeconds": 10
  },
  "validation": {
    "journeyCountExact": true,
    "warmupArrivalCountTolerance": {
      "absoluteIterations": 2,
      "relative": 0.05
    },
    "minimumApiSamples": null
  },
  "inventory": {
    "mode": "db"
  },
  "profile": "overseas-high",
  "workloadModel": "reselection",
  "reselection": {
    "selectionPolicy": "preferred-region-then-other-then-all",
    "thinkTime": {
      "enabled": false,
      "distribution": null,
      "duration": null,
      "min": null,
      "max": null
    },
    "abandonment": {
      "enabled": false,
      "maxReselections": null,
      "maxDuration": null
    },
    "safetyGuard": {
      "maxJourneyDuration": "10m"
    }
  }
}
